[Unit]
Description=ROC media engine (GStreamer in-process)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oxe
Group=oxe
WorkingDirectory=/opt/applications/roc-media-engine
Environment=RUST_LOG=info
ExecStart=/opt/applications/roc-media-engine/target/release/roc-media-engine --config /opt/applications/roc-media-engine/config.yaml
# Build with: cargo build --release -p roc-engine --features gst
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
# Single process owns all pipelines — kill the cgroup on stop.
KillMode=control-group
TimeoutStopSec=30
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
